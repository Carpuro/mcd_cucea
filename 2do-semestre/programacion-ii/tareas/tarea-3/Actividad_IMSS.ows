	<node_properties>
		<properties node_id="0" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03\xe9\x00\x00\x00u\x00\x00\x07\x08\x00\x00\x02\xeb\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\x08\x00\x00\x02\xeb\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\x08\x00\x00\x02\xeb', 'scriptLibrary': [{'name': 'Acceso a Salud', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import pyodbc\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\n\nconn = pyodbc.connect(\n    \'DRIVER={ODBC Driver 17 for SQL Server};\'\n    \'SERVER=localhost;\'\n    \'DATABASE=Defunciones_2000;\'\n    \'Trusted_Connection=yes;\'\n)\n\ncursor = conn.cursor()\ncursor.execute("SELECT tipo_servicio, total FROM tbl_acceso_resumen")\nrows = cursor.fetchall()\nconn.close()\n\ntotal_general = sum([row[1] for row in rows])\nservicios = list(set([row[0] for row in rows]))\n\ntipo_var = DiscreteVariable("tipo_servicio", values=servicios)\ntotal_var = ContinuousVariable("total")\npct_var = ContinuousVariable("porcentaje")\netiqueta_var = StringVariable("etiqueta")\n\ndomain = Domain(\n    [total_var, pct_var, tipo_var],\n    metas=[etiqueta_var]\n)\n\nX = np.array([\n    [row[1], round(row[1]/total_general*100, 2), servicios.index(row[0])]\n    for row in rows\n], dtype=float)\n\nmetas = np.array([\n    [f"{row[1]/1e6:.1f}M\\n{round(row[1]/total_general*100, 1)}%"]\n    for row in rows\n], dtype=object)\n\nout_data = Table.from_numpy(domain, X, metas=metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa9\x00\x00\x00g\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
