		<properties node_id="13" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x037\x00\x00\x00\xd6\x00\x00\x07w\x00\x00\x02\xf4\x00\x00\x037\x00\x00\x00\xf5\x00\x00\x07w\x00\x00\x02\xf4\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x037\x00\x00\x00\xf5\x00\x00\x07w\x00\x00\x02\xf4', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [0], 'columns': [0, 1, 2, 3, 4]}, 'stored_sort': [('Cluster', 1)], '__version__': 1}</properties>
		<properties node_id="14" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03\xe9\x00\x00\x00u\x00\x00\x07\r\x00\x00\x02\xeb\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\r\x00\x00\x02\xeb\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\r\x00\x00\x02\xeb', 'scriptLibrary': [{'name': 'Acceso a Salud', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import pyodbc\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\nconn = pyodbc.connect(\n    \'DRIVER={ODBC Driver 17 for SQL Server};\'\n    \'SERVER=localhost;\'\n    \'DATABASE=Defunciones_2000;\'\n    \'Trusted_Connection=yes;\'\n)\n\ncursor = conn.cursor()\ncursor.execute("""\n    SELECT TOP 100000\n        CAST(ENT AS INT) AS ENT,\n        CAST(SEXO AS INT) AS SEXO,\n        CAST(EDAD AS INT) AS EDAD,\n        NOTIEDER\n    FROM defunciones\n    WHERE EDAD NOT IN (\'999\', \'\')\n      AND SEXO IN (\'1\', \'2\')\n      AND ENT IS NOT NULL\n""")\nrows = cursor.fetchall()\nconn.close()\n\ncobertura_vals = [\'Sin cobertura\', \'Con cobertura\']\ncobertura_var = DiscreteVariable("cobertura", values=cobertura_vals)\nent_var = ContinuousVariable("estado")\nsexo_var = ContinuousVariable("sexo")\nedad_var = ContinuousVariable("edad")\n\ndomain = Domain(\n    [ent_var, sexo_var, edad_var],\n    class_vars=cobertura_var\n)\n\nX = []\ny = []\nfor row in rows:\n    try:\n        ent = float(row[0])\n        sexo = float(row[1])\n        edad = float(row[2])\n        # NULL en NOTIEDER significa que tiene cobertura (IMSS, ISSSTE, etc.)\n        # \'5\' en NOTIEDER significa sin derechohabiencia\n        target = 0 if row[3] == \'5\' else 1\n        X.append([ent, sexo, edad])\n        y.append(target)\n    except:\n        pass\n\nX = np.array(X, dtype=float)\ny = np.array(y, dtype=float)\n\nout_data = Table.from_numpy(domain, X, y)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa9\x00\x00\x00g\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
