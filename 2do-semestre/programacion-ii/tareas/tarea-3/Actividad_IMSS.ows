		<properties node_id="3" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03\xe9\x00\x00\x00u\x00\x00\x07\r\x00\x00\x02\xeb\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\r\x00\x00\x02\xeb\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03\xe9\x00\x00\x00\x94\x00\x00\x07\r\x00\x00\x02\xeb', 'scriptLibrary': [{'name': 'Cobertura por Estado', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import pyodbc\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\n\nconn = pyodbc.connect(\n    \'DRIVER={ODBC Driver 17 for SQL Server};\'\n    \'SERVER=localhost;\'\n    \'DATABASE=Defunciones_2000;\'\n    \'Trusted_Connection=yes;\'\n)\n\ncursor = conn.cursor()\ncursor.execute("""\n    SELECT nombre_estado, con_imss, sin_derechohabiencia, total_poblacion\n    FROM tbl_estados_resumen\n""")\nrows = cursor.fetchall()\nconn.close()\n\nregiones = {\n    \'Baja California\': \'Noroeste\', \'Baja California Sur\': \'Noroeste\',\n    \'Sonora\': \'Noroeste\', \'Sinaloa\': \'Noroeste\',\n    \'Chihuahua\': \'Noroeste\', \'Durango\': \'Noroeste\',\n    \'Coahuila\': \'Noreste\', \'Nuevo Leon\': \'Noreste\', \'Tamaulipas\': \'Noreste\',\n    \'Jalisco\': \'Occidente\', \'Nayarit\': \'Occidente\',\n    \'Colima\': \'Occidente\', \'Michoacan\': \'Occidente\',\n    \'Aguascalientes\': \'Centro-Norte\', \'Guanajuato\': \'Centro-Norte\',\n    \'San Luis Potosi\': \'Centro-Norte\', \'Zacatecas\': \'Centro-Norte\',\n    \'Queretaro\': \'Centro-Norte\',\n    \'Ciudad de Mexico\': \'Centro\', \'Estado de Mexico\': \'Centro\',\n    \'Morelos\': \'Centro\', \'Hidalgo\': \'Centro\',\n    \'Tlaxcala\': \'Centro\', \'Puebla\': \'Centro\',\n    \'Veracruz\': \'Golfo\', \'Tabasco\': \'Golfo\',\n    \'Guerrero\': \'Suroeste\', \'Oaxaca\': \'Suroeste\', \'Chiapas\': \'Suroeste\',\n    \'Yucatan\': \'Sureste\', \'Campeche\': \'Sureste\', \'Quintana Roo\': \'Sureste\'\n}\n\nlista_regiones = [\'Noroeste\', \'Noreste\', \'Occidente\', \'Centro-Norte\',\n                  \'Centro\', \'Golfo\', \'Suroeste\', \'Sureste\']\n\nrows_sorted = sorted(rows, key=lambda x: x[2]/x[3], reverse=True)\n\n# Variables numéricas para el clustering\npct_sin_var = ContinuousVariable("pct_sin_cobertura")\npct_imss_var = ContinuousVariable("pct_con_imss")\nregion_var = DiscreteVariable("region", values=lista_regiones)\n\n# Estado como StringVariable en metas — así aparece en Annotations\nestado_meta = StringVariable("estado")\n\ndomain = Domain(\n    [pct_sin_var, pct_imss_var, region_var],  # features\n    metas=[estado_meta]                         # aquí va el nombre del estado\n)\n\nX = np.array([\n    [round(row[2]/row[3]*100, 1),\n     round(row[1]/row[3]*100, 1),\n     lista_regiones.index(regiones.get(row[0], \'Centro\'))]\n    for row in rows_sorted\n], dtype=float)\n\nmetas = np.array([[row[0]] for row in rows_sorted], dtype=object)\n\nout_data = Table.from_numpy(domain, X, metas=metas)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa9\x00\x00\x00g\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
