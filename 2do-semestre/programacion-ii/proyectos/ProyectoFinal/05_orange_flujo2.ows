	<node_properties>
		<properties node_id="0" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'Cargar vista_riesgo_jalisco', 'script': '', 'filename': None}], 'scriptText': 'import pyodbc\nimport numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\n# Conexion a SQL Server (homelab)\nconn = pyodbc.connect(\n    \'DRIVER={ODBC Driver 17 for SQL Server};\'\n    \'SERVER=localhost,1433;\'\n    \'DATABASE=ai_automation_risk_jalisco;\'\n    \'Trusted_Connection=yes;\'\n    \'TrustServerCertificate=yes;\'\n)\ncursor = conn.cursor()\ncursor.execute(\n    \'SELECT nivel_educativo, ingreso_mensual, edad, tamanio_empresa, ira,\'\n    \' rti, cognitive_demand, social_interaction, creativity, automation_risk,\'\n    \' gpt_exposure_score, moravec_index, dual_factor_score, iceberg_score,\'\n    \' digital_access, sector, formalidad, riesgo_categoria\'\n    \' FROM dbo.vista_riesgo_jalisco\'\n)\nrows = cursor.fetchall()\nconn.close()\n\nsectores     = [\'Agricultura\', \'Comercio\', \'Construccion\', \'Educacion\', \'Finanzas\',\n                \'Manufactura\', \'Salud\', \'Servicios\', \'Tecnologia\', \'Transporte\']\nformalidades = [\'Formal\', \'Informal\']\ncategorias   = [\'Alto\', \'Bajo\', \'Medio\']\n\ncont_vars = [\n    \'nivel_educativo\', \'ingreso_mensual\', \'edad\', \'tamanio_empresa\', \'ira\',\n    \'rti\', \'cognitive_demand\', \'social_interaction\', \'creativity\', \'automation_risk\',\n    \'gpt_exposure_score\', \'moravec_index\', \'dual_factor_score\', \'iceberg_score\', \'digital_access\',\n]\ndomain = Domain(\n    [ContinuousVariable(n) for n in cont_vars] +\n    [DiscreteVariable(\'sector\', values=sectores),\n     DiscreteVariable(\'formalidad\', values=formalidades)],\n    class_vars=DiscreteVariable(\'riesgo_categoria\', values=categorias)\n)\n\nX, y = [], []\nfor row in rows:\n    try:\n        xr = [float(row[i]) for i in range(15)]\n        xr.append(float(sectores.index(str(row[15]))) if str(row[15]) in sectores else 0.0)\n        xr.append(float(formalidades.index(str(row[16]))) if str(row[16]) in formalidades else 0.0)\n        y.append(float(categorias.index(str(row[17]))) if str(row[17]) in categorias else 0.0)\n        X.append(xr)\n    except:\n        pass\n\nout_data = Table.from_numpy(domain, np.array(X, dtype=float), np.array(y, dtype=float))\nprint(f\'Datos cargados: {len(out_data)} trabajadores\')', 'splitterState': None, 'vimModeEnabled': False, '__version__': 2}</properties>
