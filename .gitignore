# ── Power BI ──────────────────────────────────────────────────────────────────
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix.bak

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
build/
develop-eggs/
dist/
*.egg-info/
*.egg

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── R ─────────────────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.ows.bak

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── PySpark / Hadoop ──────────────────────────────────────────────────────────
metastore_db/
derby.log
spark-warehouse/

# ── Datos fuente grandes (en carpetas datos/) ─────────────────────────────────
# Los CSVs pequeños en notebooks/, sessions/, tareas/ se conservan.
# Los archivos en subcarpetas datos/ son datasets fuente grandes.
**/datos/*.csv
**/datos/*.parquet
**/datos/*.hdf5
**/datos/*.npz
**/datos/*.npy
**/datos/*.pkl
**/datos/*.zip
**/datos/*.tar
**/datos/*.gz
**/datos/*.rar
!**/datos/.gitkeep
!**/datos/README.md

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Office — archivos de bloqueo temporales ───────────────────────────────────
~$*

# ── Logs y temporales ─────────────────────────────────────────────────────────
*.log
*.tmp
.cache/

# ── Secretos y config local ───────────────────────────────────────────────────
.env
.env.*
config.local.py
secrets.py
